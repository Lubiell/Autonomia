{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/node_modules/**)",
      "Read(./**/.venv/**)",
      "Read(./**/venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/coverage/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install -g:*)",
      "Bash(pip install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  }
}
