{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/node_modules/**)",
      "Read(./**/.venv/**)",
      "Read(./**/venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/coverage/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -fd *)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install -g:*)",
      "Bash(pip install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "PowerShell(git push *)",
      "PowerShell(npm install -g *)",
      "PowerShell(pip install *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)"
    ]
  }
}
